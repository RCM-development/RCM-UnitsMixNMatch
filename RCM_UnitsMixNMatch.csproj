<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RCM_UnitsMixNMatch</AssemblyName>
    <RootNamespace>RCM_UnitsMixNMatch</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0649;CS0169;CS0414;CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <!-- Paths to the installed game. Override with -p:GameDir=... if the game lives elsewhere. -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Rogue Command</GameDir>
    <Managed>$(GameDir)\Rogue Command_Data\Managed</Managed>
    <BepCore>$(GameDir)\BepInEx\core</BepCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RCM-Manager\TestMod.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony -->
    <Reference Include="$(BepCore)\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepCore)\0Harmony.dll"><Private>false</Private></Reference>

    <!-- Publicized game code (generated, see ..\..\libs) -->
    <Reference Include="..\libs\Assembly-CSharp-publicized.dll"><Private>false</Private></Reference>

    <!-- All Unity engine + package assemblies shipped with the game -->
    <Reference Include="$(Managed)\Unity*.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Newtonsoft.Json.dll"><Private>false</Private></Reference>
  </ItemGroup>

</Project>
